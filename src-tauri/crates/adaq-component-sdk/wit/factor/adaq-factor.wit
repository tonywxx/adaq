package adaq:factor@2.0.0;

interface time-series-api {
    /// Exact base-10 text for parameter values.
    type decimal = string;

    variant parameter-value {
        decimal(decimal),
        integer(s64),
        boolean(bool),
        text(string),
    }

    enum parameter-type {
        decimal,
        integer,
        boolean,
        text,
    }

    record parameter-definition {
        name: string,
        parameter-type: parameter-type,
        default-value: string,
    }

    record feature-slot {
        /// Ordered, immutable host-bound Feature Slot.
        name: string,
    }

    enum factor-scope {
        time-series,
        cross-sectional,
    }

    enum unavailability-reason {
        warmup,
        bar-gap,
        missing-input,
        missing-dependency,
        not-yet-available,
        unknown-universe,
        insufficient-coverage,
        undefined-arithmetic,
        invalid-upstream,
    }

    record feature-value {
        value: f64,
        available-at-ms: s64,
    }

    record time-series-row {
        instrument-id: string,
        observation-time-ms: s64,
        /// Dense Present values in the same order as create(feature-slots).
        slots: list<feature-value>,
    }

    record named-scalar {
        name: string,
        value: f64,
    }

    record factor-schema {
        scope: factor-scope,
        /// Exact schema identity paired with the Factor ABI version.
        schema-version: string,
        feature-slots: list<feature-slot>,
        parameters: list<parameter-definition>,
        output-names: list<string>,
        warmup-bars: u32,
    }

    record factor-result {
        instrument-id: string,
        observation-time-ms: s64,
        /// none is a typed warmup or unavailable result; identity is still required.
        values: option<list<named-scalar>>,
    }

    resource instance {
        /// Input and output preserve causal row identity and order. State continues across calls.
        process: func(rows: list<time-series-row>)
            -> result<list<factor-result>, string>;
    }

    describe: func() -> result<factor-schema, string>;
    create: func(feature-slots: list<feature-slot>, parameters: list<parameter-value>)
        -> result<instance, string>;
}

interface cross-sectional-api {
    type decimal = string;

    variant parameter-value {
        decimal(decimal),
        integer(s64),
        boolean(bool),
        text(string),
    }

    enum parameter-type {
        decimal,
        integer,
        boolean,
        text,
    }

    record parameter-definition {
        name: string,
        parameter-type: parameter-type,
        default-value: string,
    }

    record feature-slot {
        name: string,
    }

    enum factor-scope {
        time-series,
        cross-sectional,
    }

    enum unavailability-reason {
        warmup,
        bar-gap,
        missing-input,
        missing-dependency,
        not-yet-available,
        unknown-universe,
        insufficient-coverage,
        undefined-arithmetic,
        invalid-upstream,
    }

    record feature-value {
        value: f64,
        available-at-ms: s64,
    }

    variant feature-cell {
        available(feature-value),
        unavailable(unavailability-reason),
    }

    record cross-sectional-row {
        instrument-id: string,
        observation-time-ms: s64,
        /// Every Point-in-Time Universe member remains in deterministic order.
        slots: list<feature-cell>,
    }

    record named-scalar {
        name: string,
        value: f64,
    }

    record factor-schema {
        scope: factor-scope,
        /// Exact schema identity paired with the Factor ABI version.
        schema-version: string,
        feature-slots: list<feature-slot>,
        parameters: list<parameter-definition>,
        output-names: list<string>,
        warmup-bars: u32,
    }

    record factor-result {
        instrument-id: string,
        observation-time-ms: s64,
        /// One identity-preserving result is required for every Universe member.
        values: option<list<named-scalar>>,
    }

    resource instance {
        /// Input and output preserve Point-in-Time Universe identity and order.
        process: func(rows: list<cross-sectional-row>)
            -> result<list<factor-result>, string>;
    }

    describe: func() -> result<factor-schema, string>;
    create: func(feature-slots: list<feature-slot>, parameters: list<parameter-value>)
        -> result<instance, string>;
}

world time-series {
    export time-series-api;
}

world cross-sectional {
    export cross-sectional-api;
}
