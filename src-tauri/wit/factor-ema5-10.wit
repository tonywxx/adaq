package adaq:factor@1.0.0;

interface api {
    enum component-category {
        factor,
        strategy,
    }

    enum signal-side {
        buy,
        sell,
        neutral,
    }

    record signal {
        side: signal-side,
        strength: f64,
        fast-ema: f64,
        slow-ema: f64,
        timeframe: string,
    }

    record meta-info {
        uuid: string,
        name: string,
        category: component-category,
        component-type: string,
        description: string,
        version: string,
        price: string,
        currency: string,
        usage: string,
        latest-update-date: string,
        recommended-timeframe: string,
        minimum-closes: u32,
    }

    /// Evaluates only the latest bar. Prices must be chronological, oldest first.
    evaluate: func(closes: list<f64>, timeframe: option<string>) -> result<signal, string>;

    get-meta-info: func() -> meta-info;
}

world ema-5-10 {
    export api;
}
